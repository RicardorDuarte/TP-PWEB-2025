@page "/checkout"
@using RCLGeral.Models
@using RCLGeral.Services
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject IAuthService AuthService
@inject ICarrinhoService CarrinhoService
@inject NavigationManager Navigation

<PageTitle>Checkout - MyMedia</PageTitle>

<div class="checkout-page">
    <div class="container">
        <h1 class="checkout-title">Finalizar Encomenda</h1>

        @if (isLoading)
        {
            <div class="loading-container">
                <p>A carregar...</p>
            </div>
        }
        else if (CarrinhoService.Carrinho.TotalItens == 0)
        {
            <div class="empty-cart">
                <h2>O seu carrinho está vazio</h2>
                <p>Adicione produtos ao carrinho antes de fazer checkout.</p>
                <a href="/" class="btn btn-primary">Ver Produtos</a>
            </div>
        }
        else
        {
            <div class="checkout-grid">
                <!-- Formulário de Checkout -->
                <div class="checkout-form-section">
                    <EditForm Model="checkoutModel" OnValidSubmit="FinalizarEncomenda">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success">@successMessage</div>
                        }

                        <!-- Dados Pessoais -->
                        <div class="form-section">
                            <h3>Dados Pessoais</h3>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nome *</label>
                                    <InputText @bind-Value="checkoutModel.Nome" class="form-control" placeholder="Seu nome" />
                                    <ValidationMessage For="() => checkoutModel.Nome" class="text-danger" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Apelido *</label>
                                    <InputText @bind-Value="checkoutModel.Apelido" class="form-control" placeholder="Seu apelido" />
                                    <ValidationMessage For="() => checkoutModel.Apelido" class="text-danger" />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Email *</label>
                                    <InputText @bind-Value="checkoutModel.Email" class="form-control" placeholder="seu@email.com" type="email" />
                                    <ValidationMessage For="() => checkoutModel.Email" class="text-danger" />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Telefone</label>
                                    <InputText @bind-Value="checkoutModel.Telefone" class="form-control" placeholder="+351 912 345 678" />
                                </div>
                            </div>
                        </div>

                        <!-- Morada de Entrega -->
                        <div class="form-section">
                            <h3>Morada de Entrega</h3>
                            <div class="mb-3">
                                <label class="form-label">Morada *</label>
                                <InputText @bind-Value="checkoutModel.Morada" class="form-control" placeholder="Rua, número, andar" />
                                <ValidationMessage For="() => checkoutModel.Morada" class="text-danger" />
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Código Postal *</label>
                                    <InputText @bind-Value="checkoutModel.CodigoPostal" class="form-control" placeholder="1234-567" />
                                    <ValidationMessage For="() => checkoutModel.CodigoPostal" class="text-danger" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Cidade *</label>
                                    <InputText @bind-Value="checkoutModel.Cidade" class="form-control" placeholder="Lisboa" />
                                    <ValidationMessage For="() => checkoutModel.Cidade" class="text-danger" />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">País</label>
                                    <InputSelect @bind-Value="checkoutModel.Pais" class="form-select">
                                        <option value="Portugal">Portugal</option>
                                        <option value="Espanha">Espanha</option>
                                        <option value="França">França</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="form-check mb-3">
                                <InputCheckbox @bind-Value="checkoutModel.MoradaFaturacaoDiferente" class="form-check-input" id="moradaDiferente" />
                                <label class="form-check-label" for="moradaDiferente">
                                    Morada de faturação diferente da entrega
                                </label>
                            </div>
                        </div>

                        @if (checkoutModel.MoradaFaturacaoDiferente)
                        {
                            <div class="form-section">
                                <h3>Morada de Faturação</h3>
                                <div class="mb-3">
                                    <label class="form-label">Morada</label>
                                    <InputText @bind-Value="checkoutModel.MoradaFaturacao" class="form-control" />
                                </div>
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Código Postal</label>
                                        <InputText @bind-Value="checkoutModel.CodigoPostalFaturacao" class="form-control" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">Cidade</label>
                                        <InputText @bind-Value="checkoutModel.CidadeFaturacao" class="form-control" />
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label">País</label>
                                        <InputSelect @bind-Value="checkoutModel.PaisFaturacao" class="form-select">
                                            <option value="Portugal">Portugal</option>
                                            <option value="Espanha">Espanha</option>
                                            <option value="França">França</option>
                                        </InputSelect>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Método de Pagamento -->
                        <div class="form-section">
                            <h3>Método de Pagamento</h3>
                            <div class="payment-methods-grid">
                                <div class="payment-method-option @(checkoutModel.MetodoPagamento == "MBWay" ? "selected" : "")"
                                     @onclick="@(() => checkoutModel.MetodoPagamento = "MBWay")">
                                    <span class="payment-method-name">MB WAY</span>
                                </div>
                                <div class="payment-method-option @(checkoutModel.MetodoPagamento == "Multibanco" ? "selected" : "")"
                                     @onclick="@(() => checkoutModel.MetodoPagamento = "Multibanco")">
                                    <span class="payment-method-name">Multibanco</span>
                                </div>
                                <div class="payment-method-option @(checkoutModel.MetodoPagamento == "CartaoCredito" ? "selected" : "")"
                                     @onclick="@(() => checkoutModel.MetodoPagamento = "CartaoCredito")">
                                    <span class="payment-method-name">Cartão</span>
                                </div>
                                <div class="payment-method-option @(checkoutModel.MetodoPagamento == "Transferencia" ? "selected" : "")"
                                     @onclick="@(() => checkoutModel.MetodoPagamento = "Transferencia")">
                                    <span class="payment-method-name">Transferência</span>
                                </div>
                                <div class="payment-method-option payment-method-later @(checkoutModel.MetodoPagamento == "PagarDepois" ? "selected" : "")"
                                     @onclick="@(() => checkoutModel.MetodoPagamento = "PagarDepois")">
                                    <span class="payment-method-name">Pagar mais tarde</span>
                                    <small class="payment-method-desc">Reserva por 48h</small>
                                </div>
                            </div>

                            <!-- Campos dinâmicos por método de pagamento -->
                            <div class="payment-details mt-3">
                                @if (checkoutModel.MetodoPagamento == "MBWay")
                                {
                                    <div class="payment-form-mbway">
                                        <div class="mb-3">
                                            <label class="form-label"><strong>Número de telemóvel MB WAY</strong></label>
                                            <InputText @bind-Value="checkoutModel.TelefoneMBWay" class="form-control" placeholder="912 345 678" style="max-width: 250px;" />
                                            <small class="text-muted">Receberá uma notificação na app MB WAY para confirmar o pagamento.</small>
                                        </div>
                                    </div>
                                }
                                else if (checkoutModel.MetodoPagamento == "Multibanco")
                                {
                                    <div class="payment-form-multibanco">
                                        <div class="multibanco-card">
                                            <h6 class="multibanco-title">Dados para pagamento Multibanco</h6>
                                            <div class="multibanco-details">
                                                <div class="multibanco-detail-row">
                                                    <span class="multibanco-detail-label">Entidade</span>
                                                    <span class="multibanco-detail-value">21 312</span>
                                                </div>
                                                <div class="multibanco-detail-row">
                                                    <span class="multibanco-detail-label">Referência</span>
                                                    <span class="multibanco-detail-value">@GerarReferenciaMB()</span>
                                                </div>
                                                <div class="multibanco-detail-row multibanco-detail-total">
                                                    <span class="multibanco-detail-label">Valor a pagar</span>
                                                    <span class="multibanco-detail-value">@FormatarPreco(CarrinhoService.Carrinho.Total)</span>
                                                </div>
                                            </div>
                                            <p class="multibanco-note">A referência é válida por 72 horas. Após pagamento, a encomenda será processada automaticamente.</p>
                                        </div>
                                    </div>
                                }
                                else if (checkoutModel.MetodoPagamento == "CartaoCredito")
                                {
                                    <div class="payment-form-cartao">
                                        <div class="mb-3">
                                            <label class="form-label"><strong>Número do cartão</strong></label>
                                            <InputText @bind-Value="checkoutModel.NumeroCartao" class="form-control" placeholder="1234 5678 9012 3456" />
                                        </div>
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">Validade</label>
                                                <InputText @bind-Value="checkoutModel.ValidadeCartao" class="form-control" placeholder="MM/AA" />
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label">CVV</label>
                                                <InputText @bind-Value="checkoutModel.CVV" class="form-control" placeholder="123" type="password" />
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Nome no cartão</label>
                                            <InputText @bind-Value="checkoutModel.NomeCartao" class="form-control" placeholder="NOME APELIDO" />
                                        </div>
                                    </div>
                                }
                                else if (checkoutModel.MetodoPagamento == "Transferencia")
                                {
                                    <div class="payment-form-transferencia">
                                        <div class="bank-transfer-card">
                                            <h6 class="bank-transfer-title">Dados para Transferência Bancária</h6>
                                            <div class="bank-transfer-details">
                                                <div class="bank-detail-row">
                                                    <span class="bank-detail-label">IBAN</span>
                                                    <span class="bank-detail-value">PT50 0033 0000 4532 9876 5432 1</span>
                                                </div>
                                                <div class="bank-detail-row">
                                                    <span class="bank-detail-label">BIC/SWIFT</span>
                                                    <span class="bank-detail-value">BCOMPTPL</span>
                                                </div>
                                                <div class="bank-detail-row">
                                                    <span class="bank-detail-label">Banco</span>
                                                    <span class="bank-detail-value">Millennium BCP</span>
                                                </div>
                                                <div class="bank-detail-row">
                                                    <span class="bank-detail-label">Titular</span>
                                                    <span class="bank-detail-value">MyMedia Lda</span>
                                                </div>
                                                <div class="bank-detail-row bank-detail-total">
                                                    <span class="bank-detail-label">Valor a pagar</span>
                                                    <span class="bank-detail-value">@FormatarPreco(CarrinhoService.Carrinho.Total)</span>
                                                </div>
                                            </div>
                                            <p class="bank-transfer-note">Use o número da encomenda como referência. Processamento em 1-2 dias úteis.</p>
                                        </div>
                                    </div>
                                }
                                else if (checkoutModel.MetodoPagamento == "PagarDepois")
                                {
                                    <div class="payment-form-later">
                                        <div class="alert alert-warning">
                                            <p class="mb-0">A sua encomenda será reservada por <strong>48 horas</strong>. Pode efetuar o pagamento mais tarde na área "Minhas Encomendas".</p>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mb-3 mt-3">
                                <label class="form-label">NIF (para fatura)</label>
                                <InputText @bind-Value="checkoutModel.NIF" class="form-control" placeholder="123456789" style="max-width: 200px;" />
                            </div>
                        </div>

                        <!-- Notas -->
                        <div class="form-section">
                            <h3>Notas (opcional)</h3>
                            <div class="mb-3">
                                <InputTextArea @bind-Value="checkoutModel.Notas" class="form-control" rows="3" placeholder="Instruções especiais para entrega..." />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-lg w-100" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>A processar...</span>
                            }
                            else
                            {
                                <span>@(checkoutModel.MetodoPagamento == "PagarDepois" ? "Reservar Encomenda" : "Confirmar Encomenda") - @FormatarPreco(CarrinhoService.Carrinho.Total)</span>
                            }
                        </button>
                    </EditForm>
                </div>

                <!-- Resumo do Carrinho -->
                <div class="order-summary">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Resumo da Encomenda</h5>
                        </div>
                        <div class="card-body">
                            @foreach (var item in CarrinhoService.Carrinho.Itens)
                            {
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                    <div>
                                        <strong>@item.ProdutoNome</strong>
                                        <br />
                                        <small class="text-muted">Qtd: @item.Quantidade × @FormatarPreco(item.PrecoUnitario)</small>
                                    </div>
                                    <span>@FormatarPreco(item.Subtotal)</span>
                                </div>
                            }
                            <div class="d-flex justify-content-between mt-3">
                                <span>Subtotal</span>
                                <span>@FormatarPreco(CarrinhoService.Carrinho.Total)</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span>Envio</span>
                                <span class="text-success">Grátis</span>
                            </div>
                            <hr />
                            <div class="d-flex justify-content-between">
                                <strong>Total</strong>
                                <strong class="text-primary fs-5">@FormatarPreco(CarrinhoService.Carrinho.Total)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .checkout-page {
        padding: 2rem 0;
        background: #f8f9fa;
        min-height: 100vh;
    }

    .checkout-title {
        margin-bottom: 2rem;
    }

    .checkout-grid {
        display: grid;
        grid-template-columns: 1fr 380px;
        gap: 2rem;
    }

    .checkout-form-section {
        background: white;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    .form-section {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid #dee2e6;
    }

    .form-section h3 {
        margin-bottom: 1rem;
        font-size: 1.1rem;
    }

    /* Métodos de Pagamento - Novo Design */
    .payment-methods-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 0.75rem;
    }

    .payment-method-option {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem 0.75rem;
        border: 2px solid #dee2e6;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: white;
        min-height: 60px;
    }

    .payment-method-option:hover {
        border-color: #0d6efd;
        background-color: #f8f9ff;
    }

    .payment-method-option.selected {
        border-color: #0d6efd;
        background-color: #e7f1ff;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.15);
    }

    .payment-method-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #333;
    }

    .payment-method-desc {
        font-size: 0.75rem;
        color: #6c757d;
        margin-top: 2px;
    }

    .payment-method-later {
        background: #fff9e6;
        border-color: #ffc107;
    }

    .payment-method-later:hover {
        border-color: #e0a800;
        background-color: #fff3cd;
    }

    .payment-method-later.selected {
        border-color: #e0a800;
        background-color: #fff3cd;
        box-shadow: 0 0 0 3px rgba(255, 193, 7, 0.2);
    }

    /* Transferência Bancária - Novo Design */
    .bank-transfer-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 12px;
        padding: 1.5rem;
        color: white;
    }

    .bank-transfer-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .bank-transfer-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .bank-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
    }

    .bank-detail-label {
        font-size: 0.85rem;
        opacity: 0.85;
    }

    .bank-detail-value {
        font-weight: 600;
        font-size: 0.9rem;
        font-family: 'Courier New', monospace;
        background: rgba(255,255,255,0.15);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
    }

    .bank-detail-total {
        margin-top: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255,255,255,0.2);
    }

    .bank-detail-total .bank-detail-value {
        font-size: 1.1rem;
        background: rgba(255,255,255,0.25);
    }

    .bank-transfer-note {
        margin-top: 1rem;
        font-size: 0.8rem;
        opacity: 0.85;
        margin-bottom: 0;
    }

    /* Multibanco - Design similar */
    .multibanco-card {
        background: linear-gradient(135deg, #0066cc 0%, #004494 100%);
        border-radius: 12px;
        padding: 1.5rem;
        color: white;
    }

    .multibanco-title {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .multibanco-details {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .multibanco-detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
    }

    .multibanco-detail-label {
        font-size: 0.85rem;
        opacity: 0.85;
    }

    .multibanco-detail-value {
        font-weight: 600;
        font-size: 1rem;
        font-family: 'Courier New', monospace;
        background: rgba(255,255,255,0.15);
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        letter-spacing: 1px;
    }

    .multibanco-detail-total {
        margin-top: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1px solid rgba(255,255,255,0.2);
    }

    .multibanco-detail-total .multibanco-detail-value {
        font-size: 1.1rem;
        background: rgba(255,255,255,0.25);
    }

    .multibanco-note {
        margin-top: 1rem;
        font-size: 0.8rem;
        opacity: 0.85;
        margin-bottom: 0;
    }

    .order-summary {
        position: sticky;
        top: 1rem;
        height: fit-content;
    }

    .empty-cart {
        text-align: center;
        padding: 4rem;
        background: white;
        border-radius: 8px;
    }

    @@media (max-width: 992px) {
        .checkout-grid {
            grid-template-columns: 1fr;
        }

        .order-summary {
            order: -1;
            position: static;
        }

        .payment-methods-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .payment-methods-grid {
            grid-template-columns: 1fr 1fr;
        }

        .bank-detail-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
        }
    }
</style>

@code {
    private static readonly CultureInfo CulturaEuro = new("pt-PT");
    
    private CheckoutModel checkoutModel = new();
    private UserInfo? user;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;

    private string FormatarPreco(decimal preco) => preco.ToString("C", CulturaEuro);

    private string GerarReferenciaMB()
    {
        // Gera uma referência fictícia baseada no timestamp
        var random = new Random();
        return $"{random.Next(100, 999)} {random.Next(100, 999)} {random.Next(100, 999)}";
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Verificar autenticação
            user = await AuthService.GetUserInfoAsync();
            if (user == null)
            {
                Navigation.NavigateTo("/login?returnUrl=/checkout");
                return;
            }

            // Verificar se carrinho tem itens
            if (CarrinhoService.Carrinho.TotalItens == 0)
            {
                Navigation.NavigateTo("/carrinho");
                return;
            }

            // Pré-preencher dados do utilizador
            checkoutModel.Nome = user.Nome;
            checkoutModel.Apelido = user.Apelido;
            checkoutModel.Email = user.Email;
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FinalizarEncomenda()
    {
        if (CarrinhoService.Carrinho.TotalItens == 0)
        {
            errorMessage = "O carrinho está vazio.";
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var isPagarDepois = checkoutModel.MetodoPagamento == "PagarDepois";
            
            var encomenda = new
            {
                ClienteId = user!.Id,
                ClienteNome = $"{checkoutModel.Nome} {checkoutModel.Apelido}".Trim(),
                MoradaEntrega = checkoutModel.MoradaCompleta,
                DataCriacao = DateTime.Now,
                EstadoEncomenda = "Pendente",
                EstadoPagamento = isPagarDepois ? "Aguarda Pagamento" : "Pendente",
                MetodoPagamento = isPagarDepois ? "" : checkoutModel.MetodoPagamento,
                ValorTotal = CarrinhoService.Carrinho.Total,
                Pedidos = CarrinhoService.Carrinho.Itens.Select(item => new
                {
                    Id = 0,
                    ProdutoId = item.ProdutoId,
                    Quantidade = item.Quantidade,
                    PrecoUnitario = item.PrecoUnitario,
                    ValorTotal = item.Subtotal
                }).ToList()
            };

            var response = await Http.PostAsJsonAsync("api/Encomendas", encomenda);

            if (response.IsSuccessStatusCode)
            {
                CarrinhoService.Limpar();
                
                if (isPagarDepois)
                {
                    successMessage = "Encomenda reservada! Pode efetuar o pagamento mais tarde na área 'Minhas Encomendas'.";
                    await Task.Delay(2000);
                    Navigation.NavigateTo("/minhas-encomendas");
                }
                else
                {
                    // Ler a encomenda criada para obter o ID
                    var encomendaCriada = await response.Content.ReadFromJsonAsync<EncomendaCriadaResponse>();
                    
                    if (encomendaCriada != null)
                    {
                        // Chamar o endpoint de pagamento para marcar como paga
                        var pagamentoResponse = await Http.PostAsJsonAsync(
                            $"api/Encomendas/{encomendaCriada.Id}/pagar", 
                            new { MetodoPagamento = checkoutModel.MetodoPagamento });
                        
                        if (pagamentoResponse.IsSuccessStatusCode)
                        {
                            successMessage = "Encomenda criada e paga com sucesso!";
                        }
                        else
                        {
                            successMessage = "Encomenda criada! O pagamento será processado em breve.";
                        }
                    }
                    else
                    {
                        successMessage = "Encomenda criada com sucesso!";
                    }
                    
                    await Task.Delay(2000);
                    Navigation.NavigateTo("/minhas-encomendas");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                errorMessage = $"Erro ao criar encomenda: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private class EncomendaCriadaResponse
    {
        public int Id { get; set; }
    }
}